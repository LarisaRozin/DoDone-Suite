{
  "name": "dodone",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --mode=DevPlayDebug --appId=com.larisarozin.dodone.dev",
    "android:prod": "react-native run-android --mode=ProdPlayDebug --appId=com.larisarozin.dodone",
    "android-stable": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-dev-environment.ps1 && react-native run-android --mode=DevPlayDebug --appId=com.larisarozin.dodone.dev",
    "ios": "react-native run-ios",
    "ios:device": "react-native run-ios --device",
    "lint": "eslint .",
    "start": "react-native start",
    "start-fresh": "react-native start --reset-cache",
    "setup-dev": "powershell -ExecutionPolicy Bypass -File ./setup-dev-environment.ps1",
    "adb-restart": "adb kill-server && adb start-server && adb devices",
    "test": "jest",
    "build": "echo \"No build step defined. Use 'npx react-native run-android' or 'run-ios' to build the app.\""
  },
  "dependencies": {
    "@guc/core": "^0.6.0",
    "@kolking/react-native-rating": "^1.4.1",
