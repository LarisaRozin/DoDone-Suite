    "@react-native-firebase/perf": "^23.5.0",
    "@react-native-vector-icons/material-design-icons": "^12.0.1",
    "@react-native/new-app-screen": "0.86.0",
    "@react-navigation/native": "^7.1.11",
    "@react-navigation/native-stack": "^7.3.18",
    "@react-navigation/stack": "^7.3.4",
    "@types/uuid": "^10.0.0",
    "expo-dev-client": "^6.0.13",
    "lodash": "^4.17.21",
    "lottie-react-native": "^7.3.4",
    "metro-cache": "^0.83.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
